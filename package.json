{
  "name": "coup-de-pouce-eitt",
  "private": true,
  "version": "0.1.0",
  "description": "Coup de Pouce by EITT — plateforme d'entraide numérique (MVP)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:local": "node scripts/build-local.mjs",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:sql": "bash supabase/tests/run.sh",
    "sql:bundle": "node scripts/bundle-sql.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
