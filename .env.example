# Copiez ce fichier en .env.local puis renseignez vos valeurs (Supabase > Project Settings > API).
# La clé "anon" (publique) est faite pour le navigateur : la sécurité repose sur les règles RLS du dossier supabase/.
# NE METTEZ JAMAIS la clé "service_role" ici : elle donne un accès total à la base.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Sous-dossier d'hébergement. "/" pour un domaine dédié (Vercel, Netlify, Cloudflare Pages),
# "/nom-du-depot/" pour GitHub Pages (https://utilisateur.github.io/nom-du-depot/).
VITE_BASE=/
